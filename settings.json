{
    "AIModel": "ai_lmstudio.json",
    "CURLOPT_CONNECTTIMEOUT": 5,
    "CURLOPT_TIMEOUT": 15,
    "Language": "Russian",
    "bookRetries": 3,
    "choicesSeparator": "\u001f",
    "playerDead": "[dead]",
    "nextChapter": "[chapter]",
    "fontSizeOffset": 4,
    "maxRetries": 3,
    "maxTurnsForce": 10,
    "retryDelayMs": 1000,
    "preprocessingPipeline": [
        { "action": "replace", "target": "\\n", "replacement": "\n" },
        { "action": "replace", "target": "\"narrative\":", "replacement": "" },
        { "action": "replace", "target": "\"narrative\" :", "replacement": "" },
        { "action": "replace", "target": "\"options\":", "replacement": "choicesSeparator" },
        { "action": "replace", "target": "\"choices\":", "replacement": "choicesSeparator" },
        { "action": "replace", "target": "\"options\" :", "replacement": "choicesSeparator" },
        { "action": "replace", "target": "\"choices\" :", "replacement": "choicesSeparator" },
        
        { "action": "replace", "target": "[dead ]", "replacement": "[dead]" },
        { "action": "replace", "target": "[ dead]", "replacement": "[dead]" },
        { "action": "replace", "target": "[death]", "replacement": "[dead]" },
        { "action": "replace", "target": "[game_over]", "replacement": "[dead]" },
        { "action": "replace", "target": "[player_dead]", "replacement": "[dead]" },
        { "action": "replace", "target": "<player_dead/>", "replacement": "[dead]" },
        
        { "action": "replace", "target": "[chapter ]", "replacement": "[chapter]" },
        { "action": "replace", "target": "[ chapter]", "replacement": "[chapter]" },
        { "action": "replace", "target": "[next_chapter]", "replacement": "[chapter]" },
        { "action": "replace", "target": "[nextchapter]", "replacement": "[chapter]" },
        { "action": "replace", "target": "<next_chapter>", "replacement": "[chapter]" },
        { "action": "replace", "target": "</next_chapter>", "replacement": "" },
        { "action": "replace", "target": "[/next_chapter]", "replacement": "" },
        
        { "action": "remove_chars", "target": "{}" }
    ],
    "formatReminder": [
        "[REMINDER: Use the exact output format from your system prompt: narrative text first, then '\u001f', then 2-4 choices each on its own line '- ']"
    ],
    "systemPrompt": [
        "You are a text adventure narrator. Narrate in the user's language. Be concise (1-2 short paragraphs). Advance the plot every turn — no loops or repetition.",
        "",
        "CHAPTERS: Each chapter lasts 6-8 turns. On transition append '[chapter]X' after the options (X = next chapter number).",
        "",
        "DEATH: If the player picks a fatal choice, describe their end and append '[dead]' — no options after. Never label any choice as dangerous.",
        "",
        "FORMAT: Narrative first. Then '\u001f'. Then 2-5 options each starting with '- '. NEVER use A) B) C) or 1. 2. 3. or any prefix other than '- '. Options in the same language as the story.",
        "",
        "EXAMPLE:",
        "You hear a noise behind the door. \u001f",
        "- Open the door",
        "- Listen through it",
        "- Walk away",
        "- Call for help",
        "- Break it down"
    ]
}