{
    "LOCAL": {
        "context_length": 4096,
        "temperature": 0.7,
        "gpu_offload": "max",
        "thinking": false,
        "context-shift": true,
        "flash-attn": true,
        "no-mmap": true,
        "threads": 4,
        "show_window": true
    },
    "AIModel": "ai_local.json",
    "BookTimeout": 240,
    "CURLOPT_CONNECTTIMEOUT": 5,
    "CURLOPT_TIMEOUT": 15,
    "Language": "English",
    "bookRetries": 5,
    "choicesSeparator": "<options>",
    "fontSizeOffset": 6,
    "formatReminder": [
        "REMINDER: Use the exact output format from your system prompt: narrative text first, then <options>, then 2-4 choices each on its own line '- ', then </options>\n"
    ],
    "prompt_ai_rule_options_format": "OPTIONS FORMAT: After your narrative, output <options>, then 2-5 choices each starting with '- ', then </options>\n",
    "genrePreprocessingPipeline": [
        {
            "action": "regex_replace",
            "target": "\\*",
            "replacement": ""
        },
        {
            "action": "regex_replace",
            "target": "\\n\\s*\\d+[\\.\\)]\\s*",
            "replacement": "\n"
        },
        {
            "action": "regex_replace",
            "target": "\\n\\s*[a-zA-Zа-яА-Я][\\.\\)]\\s*",
            "replacement": "\n"
        },
        {
            "action": "regex_replace",
            "target": "\\n\\s*#+\\s*",
            "replacement": "\n"
        },
        {
            "action": "regex_replace",
            "target": "(Вариант|Выбор|Option|Choice)\\s*[\\d\\w]*\\s*:\\s*",
            "replacement": ""
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\"genres\":"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\"genres\" :"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\"genre\":"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\"genre\" :"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "genres:"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "genre:"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": ","
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\""
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "'"
        },
        {
            "action": "remove_chars",
            "target": "{}[]"
        }
    ],
    "maxRetries": 3,
    "maxTurnsForce": 10,
    "nextChapter": "[chapter]",
    "playerDead": "[dead]",
    "preprocessingPipeline": [
        {
            "action": "replace",
            "replacement": "\n",
            "target": "\\n"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\"response\":"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\"narration\":"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\"narrative\":"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\"narrative\" :"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "\"story\" :"
        },
        {
            "action": "replace",
            "replacement": "choicesSeparator",
            "target": "\"options\":"
        },
        {
            "action": "replace",
            "replacement": "choicesSeparator",
            "target": "\"choices\":"
        },
        {
            "action": "replace",
            "replacement": "choicesSeparator",
            "target": "\"options\" :"
        },
        {
            "action": "replace",
            "replacement": "choicesSeparator",
            "target": "\"choices\" :"
        },
        {
            "action": "replace",
            "replacement": "[dead]",
            "target": "[dead ]"
        },
        {
            "action": "replace",
            "replacement": "[dead]",
            "target": "[ dead]"
        },
        {
            "action": "replace",
            "replacement": "[dead]",
            "target": "[death]"
        },
        {
            "action": "replace",
            "replacement": "[dead]",
            "target": "[game_over]"
        },
        {
            "action": "replace",
            "replacement": "[dead]",
            "target": "[player_dead]"
        },
        {
            "action": "replace",
            "replacement": "[dead]",
            "target": "<player_dead/>"
        },
        {
            "action": "replace",
            "replacement": "[chapter]",
            "target": "[chapter ]"
        },
        {
            "action": "replace",
            "replacement": "[chapter]",
            "target": "[ chapter]"
        },
        {
            "action": "replace",
            "replacement": "[chapter]",
            "target": "[next_chapter]"
        },
        {
            "action": "replace",
            "replacement": "[chapter]",
            "target": "[nextchapter]"
        },
        {
            "action": "replace",
            "replacement": "[chapter]",
            "target": "<next_chapter>"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "</next_chapter>"
        },
        {
            "action": "replace",
            "replacement": "",
            "target": "[/next_chapter]"
        },
        {
            "action": "remove_chars",
            "target": "{}"
        }
    ],
    "retryDelayMs": 1000,
    "systemPrompt": [
        "You are a text adventure narrator. Narrate in the user's language. Be concise (1-2 short paragraphs). Advance the plot every turn — no loops or repetition.",
        "",
        "CHAPTERS: Each chapter lasts 6-8 turns. On transition append '[chapter]' ",
        "",
        "DEATH: If the player picks a fatal choice, describe their end and append '[dead]' — no options after. Never label any choice as dangerous.",
        "",
        "FORMAT: Narrative first. Then output interactive choices wrapped inside <options> and </options> tags. Each option must start with a hyphen and a space '- '. NEVER use A) B) C) or 1. 2. 3. or any prefix other than '- '. Options in the same language as the story.",
        "",
        "EXAMPLE:",
        "You hear a noise behind the door. <options>\n- Open the door\n- Listen through it\n- Walk away\n- Call for help\n- Break it down\n</options>"
    ]
}