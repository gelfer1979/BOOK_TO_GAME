	@echo ... parse_rawml.s
	@echo ... read.obj
	@echo ... read.i
	@echo ... read.s
	@echo ... structure.obj
	@echo ... structure.i
	@echo ... structure.s
	@echo ... util.obj
	@echo ... util.i
	@echo ... util.s
	@echo ... write.obj
	@echo ... write.i
	@echo ... write.s
.PHONY : help



#=============================================================================
# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /d C:\games\BOOK_TO_GAME\build_webview_test2 && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles\Makefile.cmake 0
.PHONY : cmake_check_build_system

