{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug and Run (MinGW - GCC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${workspaceFolderBasename}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake Build"
        },
        {
            "name": "Launch Web Preview (Chrome)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8000/BOOK_TO_GAME.html",
            "webRoot": "${workspaceFolder}/build_web"
        }
    ]
}
