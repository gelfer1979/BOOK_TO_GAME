# This should most probably benefit from getting a "Requires:" field added
# dynamically by configure.
#
prefix=C:/Program Files (x86)/BOOK_TO_GAME
exec_prefix=${prefix}
libdir=C:/Program Files (x86)/BOOK_TO_GAME/lib
includedir=${prefix}/include
supported_protocols="HTTP IPFS IPNS"
supported_features="IPv6 UnixSockets libz AsynchDNS Largefile alt-svc HSTS threadsafe"

Name: libcurl
URL: https://curl.se/
Description: Library to transfer files with ftp, http, etc.
Version: 8.8.0-DEV
Libs: -L${libdir} -lcurl  -l:libunwind.a -ldl -lc -l:libunwind.a -ldl -pthread -LC:/android/sdk/ndk/25.2.9519653/toolchains/llvm/prebuilt/windows-x86_64/sysroot/usr/lib/x86_64-linux-android/21 -lz
Libs.private:  -l:libunwind.a -ldl -lc -l:libunwind.a -ldl -pthread -LC:/android/sdk/ndk/25.2.9519653/toolchains/llvm/prebuilt/windows-x86_64/sysroot/usr/lib/x86_64-linux-android/21 -lz
Cflags: -I${includedir} -DCURL_STATICLIB
